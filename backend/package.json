{
  "name": "kinledger-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate:device-tokens": "node scripts/migrate-device-tokens.js",
    "db:migrate:income": "node scripts/migrate-income.js",
    "db:migrate:task-reminders": "node scripts/migrate-task-reminders.js",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "firebase-admin": "^13.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
